            "organization_testimonial": {
                "testimonial_text": "What the world thinks about us!",
                "to_display": true,
                "testimonials": [
                    {
                        "title": "HSBC India",
                        "designation": "Partner",
                        "description": "For more than two decades, the partnership between WWF-India and HSBC India has demonstrated what's possible when organisations with a shared purpose work together. Grounded in research, evidence and citizen engagement, WWF-India's approach has helped deliver impactful programmes across diverse geographies in India.",
                        "image": "https://crowdera-platform.s3.ap-south-1.amazonaws.com/gocrowdera/background/702c1a4b-85fe-4b16-a553-ef7411f9131a_thumbnail_10.jpeg"
                    },
                    {
                        "title": "Microsoft India",
                        "designation": "Partner",
                        "description": "Our partnership with WWF-India has been a powerful example of how technology and conservation can come together for real-world impact. Through close collaboration and shared commitment, we have leveraged AI and data to strengthen forest fire preparedness and support government and community-led resilience efforts. We value WWF-India as a trusted partner in advancing sustainable, technology-enabled conservation in India.",
                        "image": "https://crowdera-platform.s3.ap-south-1.amazonaws.com/gocrowdera/background/dfa5f013-332e-4f96-95d0-f105f7bf8360_thumbnail_9.png"
                    },
                    {
                        "title": "Capgemini",
                        "designation": "Partner",
                        "description": "At Capgemini, we believe that technology and education together can unlock powerful pathways for sustainable development. Our partnership with WWF-India for One Planet Academy — an interactive digital environment-education portal — reflects this commitment. Co-creating this platform has enabled us to bring high-quality, engaging and action-oriented environmental learning to students and teachers across India.",
                        "image": "https://crowdera-platform.s3.ap-south-1.amazonaws.com/gocrowdera/background/b163989f-98bc-494b-a8af-e5c7e5f1c6a4_thumbnail_ada.jpeg"
                    },
                    {
                        "title": "Warner Bros. Discovery",
                        "designation": "Partner",
                        "description": "For over eight years, Warner Bros. Discovery has been proud to partner with WWF-India, supporting impactful efforts in tiger conservation, reducing human-tiger conflict and safeguarding the fragile mangroves of the Sundarbans. WWF-India's on-ground commitment continues to drive meaningful, lasting change for both wildlife and communities.",
                        "image": "https://crowdera-platform.s3.ap-south-1.amazonaws.com/gocrowdera/background/3cbf3b7d-1cfa-4386-a635-319b32e4e2cb_thumbnail_images.jpeg"
                    }
                ]
            },
